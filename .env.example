# Database
POSTGRES_USER=warden
POSTGRES_PASSWORD=warden
POSTGRES_DB=warden
DATABASE_URL=postgresql+psycopg://warden:warden@db:5432/warden

# Redis
REDIS_URL=redis://redis:6379

# MinIO / Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
S3_BUCKET=warden

# GitHub OAuth
GITHUB_TOKEN=
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret

# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Encryption (must be a valid base64-encoded 32-byte Fernet key)
ENCRYPTION_KEY=5qW0zXgJ_L4JnHzKpQtV9m2-bE8cDfRsZ0xY1pQrT2s=

# API
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Langfuse (optional for tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.langfuse.com